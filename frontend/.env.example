# Base URL of the EmberLedger API (branch backend-core).
# Local backend:   VITE_API_URL=http://localhost:8000
# Deployed (Render): VITE_API_URL=https://<service>.onrender.com
# Copy this file to .env.local (git-ignored) to override the default http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Base URL of the fire incident agents (python -m incident_agents serve), used by Social Alerts.
# They run on your own machine; the dashboard only reads their tickets.
VITE_INCIDENTS_URL=http://127.0.0.1:8765
