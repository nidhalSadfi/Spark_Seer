# Copy to .env (gitignored) and fill in. Values here are safe local-only defaults, never real secrets.
# docker compose reads .env from the repo root automatically; the Python code does not load it,
# so export the variables (or use your shell/IDE) when running the backend outside Docker.
# The worker and migrations read their variables through backend/settings.py.

# Postgres user created by the db container on first start.
POSTGRES_USER=emberguard
# Postgres password for that user (local development only).
POSTGRES_PASSWORD=emberguard
# Database created by the db container on first start.
POSTGRES_DB=emberguard
# Host port the db container is published on.
POSTGRES_PORT=5432
# SQLAlchemy URL (psycopg 3 driver) for the backend; must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://emberguard:emberguard@localhost:5432/emberguard
# Database for the pg-marked backend tests; docker/initdb creates it when the db volume is first initialised.
TEST_DATABASE_URL=postgresql+psycopg://emberguard:emberguard@localhost:5432/emberguard_test

# NASA FIRMS MAP_KEY for firms_tool. A non-empty FIRMS_MAP_KEY_1 takes precedence; --map-key overrides both.
FIRMS_MAP_KEY=

# OpenRouter API key for the worker's AI review; required when OPENROUTER_MODELS is not empty.
OPENROUTER_API_KEY=
# Ordered, comma-separated model fallback list (first is tried first); no default, empty = AI review disabled.
OPENROUTER_MODELS=
# OpenRouter's OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Seconds one OpenRouter request may take (capped by what is left of REVIEW_DEADLINE_S).
OPENROUTER_TIMEOUT_S=60
# HTTP retries per OpenRouter request (integer >= 0); a rate limit or failure then moves on to the next model.
OPENROUTER_RETRIES=1
# true/false: skip a review when the key has fewer free-model requests left today than one attempt needs.
OPENROUTER_QUOTA_CHECK=true
# Seconds the whole AI review (every model in turn) may take; no model is started after it.
REVIEW_DEADLINE_S=300
# Most characters one agent prompt summary or tool result may carry (>= 1000); longer ones are truncated, marked.
REVIEW_SUMMARY_MAX_CHARS=8000

# Hours between FIRMS polls by the worker (> 0, decimals allowed); written to the schedules table at startup.
FIRMS_POLL_INTERVAL_HOURS=3
# FIRMS query bbox: west,south,east,north, or `world` (spec §16: 18 FIRMS tiles, ~290 transactions per 2-day poll
# of 4 sources). Empty = -2.5,34,11.5,38 (Tunisia + Algeria north of 34°N, spec §1). New world installs: world.
FIRMS_BBOX=world
# Most days one poll fetches per source (today included) when catching up after downtime; it also caps the first
# poll. World: 30 days of 4 sources is ~3900 transactions (limit 5000 per 10 min; large polls check the key budget).
FIRMS_MAX_BACKFILL_DAYS=30
# Where raw FIRMS responses are kept as .csv.gz; relative to the working directory, normally backend/.
FIRMS_RAW_DIR=data/raw/firms
# Seconds a running job's lease lasts; the worker renews it every third of that while the job runs.
WORKER_LEASE_SECONDS=300
# Seconds between scheduler ticks.
WORKER_TICK_SECONDS=60
# Day of the month (1-28) monthly_reconcile runs, at 03:00 UTC; its schedule stays disabled until Phase 2.
RECONCILE_DAY_OF_MONTH=5
# Country boundary GeoJSON (Natural Earth admin-0, TUN + DZA) for the country clip; empty = clip disabled and reported so.
# World (spec §16): empty, no country clip.
COUNTRY_BOUNDARY_FILE=
# Static-source mask JSON from `python -m processing.build_mask`; empty = NRT mask rule disabled and reported so.
# It must be the approved calibration's mask (world: the world mask the bootstrap recorded, e.g. data/world/...).
STATIC_MASK_FILE=
# Latitude cut of the detection filter (spec §5); `none` = no cut. Empty = 34 (North Africa). World (spec §16): none.
PROCESSING_MIN_LAT=none
# Region-month drift between MODIS x k and the VIIRS reference above this % is a soft flag (never a block).
DRIFT_WARN_PCT=40
# Region-months whose summed VIIRS reference is below this are reported as insufficient_data, never flagged.
DRIFT_MIN_COUNT=50
# Days the staging rows of a finished job (held, rejected or published) are kept before the worker deletes them.
STAGING_RETENTION_DAYS=30
# Harmonized dataset the API serves; relative to the working directory, normally backend/ (api/core.py default).
EMBER_DATA=data/harmonized.parquet

# API (spec §10). With DATABASE_URL set the API serves /calendar from the approved cell_month table and
# answers /processing/*, /fires/live and /reports; unset or unreachable, it serves the parquet and those 503.
# Seconds (>= 0) between the API's checks for a new approved dataset version behind /calendar.
API_VERSION_CHECK_S=30
# Connect timeout (1-60 s) of the API's database connections; an unreachable database then fails fast.
API_DB_CONNECT_TIMEOUT_S=3
# Reviewer token for PATCH/DELETE /reports (X-Admin-Token header); empty = open, for local development only.
REPORTS_ADMIN_TOKEN=
# /fires/live (spec §16): above this many detections in the window it answers an aggregated grid instead.
FIRES_LIVE_MAX_DETECTIONS=20000
# /fires/live: a bbox wider or taller than this many degrees always gets the grid.
FIRES_LIVE_GRID_SPAN_DEG=30
# /fires/live grid: 0.25-degree cells up to this bbox span in degrees, 0.5-degree cells beyond (and without a bbox).
FIRES_LIVE_FINE_GRID_MAX_SPAN_DEG=90

# Production (docker-compose.prod.yml, DEPLOY.md): your domain for automatic HTTPS, or :80 for plain HTTP.
SITE_ADDRESS=:80
