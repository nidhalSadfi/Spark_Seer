# Copy to .env (gitignored) and fill in. Values here are safe local-only defaults, never real secrets.
# docker compose reads .env from the repo root automatically; the Python code does not load it,
# so export the variables (or use your shell/IDE) when running the backend outside Docker.
# The worker and migrations read their variables through backend/settings.py; OPENROUTER_* are not read yet.

# Postgres user created by the db container on first start.
POSTGRES_USER=emberguard
# Postgres password for that user (local development only).
POSTGRES_PASSWORD=emberguard
# Database created by the db container on first start.
POSTGRES_DB=emberguard
# Host port the db container is published on.
POSTGRES_PORT=5432
# SQLAlchemy URL (psycopg 3 driver) for the backend; must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://emberguard:emberguard@localhost:5432/emberguard
# Database for the pg-marked backend tests; docker/initdb creates it when the db volume is first initialised.
TEST_DATABASE_URL=postgresql+psycopg://emberguard:emberguard@localhost:5432/emberguard_test

# NASA FIRMS MAP_KEY for firms_tool. A non-empty FIRMS_MAP_KEY_1 takes precedence; --map-key overrides both.
FIRMS_MAP_KEY=

# OpenRouter API key for LLM calls.
OPENROUTER_API_KEY=
# Ordered, comma-separated model fallback list (first is tried first); intentionally no default.
OPENROUTER_MODELS=

# Hours between FIRMS polls by the worker (> 0, decimals allowed); written to the schedules table at startup.
FIRMS_POLL_INTERVAL_HOURS=3
# FIRMS query bbox west,south,east,north; empty = -2.5,34,11.5,38 (Tunisia + Algeria north of 34°N, spec §1).
FIRMS_BBOX=
# Most days one poll fetches per source (today included) when catching up after downtime.
FIRMS_MAX_BACKFILL_DAYS=30
# Where raw FIRMS responses are kept as .csv.gz; relative to the working directory, normally backend/.
FIRMS_RAW_DIR=data/raw/firms
# Seconds a running job's lease lasts; the worker renews it every third of that while the job runs.
WORKER_LEASE_SECONDS=300
# Seconds between scheduler ticks.
WORKER_TICK_SECONDS=60
# Day of the month (1-28) monthly_reconcile runs, at 03:00 UTC; its schedule stays disabled until Phase 2.
RECONCILE_DAY_OF_MONTH=5
# Harmonized dataset the API serves; relative to the working directory, normally backend/ (api/core.py default).
EMBER_DATA=data/harmonized.parquet
